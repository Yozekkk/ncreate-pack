#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 2 || $# -gt 4 ]]; then
  printf 'Usage: %s PACK.zip VERSION [stable|beta] [changelog]\n' "$0" >&2
  exit 2
fi

archive="$(realpath "$1")"
version="$2"
channel="${3:-stable}"
changelog="${4:-Обновление официальной сборки NCreate Server.}"
if [[ "$channel" != stable && "$channel" != beta ]]; then
  printf 'Channel must be stable or beta\n' >&2
  exit 2
fi

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo"
if [[ -n "$(git status --porcelain)" ]]; then
  printf 'Commit or stash existing changes before publishing a new pack.\n' >&2
  exit 1
fi
git fetch origin main
if [[ "$(git rev-parse HEAD)" != "$(git rev-parse origin/main)" ]]; then
  printf 'Local HEAD must match origin/main before publishing.\n' >&2
  exit 1
fi

python3 scripts/import-pack.py "$archive" "$version" --root "$repo" --changelog "$changelog"
npm ci --ignore-scripts
npm run check
publish_output="$(mktemp -d)"
trap 'rm -r -- "$publish_output"' EXIT
node scripts/prepare-release.mjs --edition ncreate-server --channel "$channel" --version "$version" --output "$publish_output"
node scripts/verify-external-sources.mjs "$publish_output/manifest.json"

git add "packs/ncreate-server/$version"
git commit -m "release(pack): prepare NCreate Server $version"
git push origin HEAD:main
gh workflow run publish-pack.yml --repo Yozekkk/ncreate-pack --ref main \
  -f edition=ncreate-server -f channel="$channel" -f version="$version"
printf 'Publishing started: https://github.com/Yozekkk/ncreate-pack/actions/workflows/publish-pack.yml\n'
